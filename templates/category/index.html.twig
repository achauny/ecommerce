{% extends 'base.html.twig' %}

{% block title %} Liste des catégories {% endblock %}

{% block body %}
    Liste des catégories
    <br/>
    <br/>

    <table>
        <thead>
        <tr>
            <th>
                ID
            </th>
            <th>
                Catégorie parent
            </th>
            <th>
                Nom
            </th>
            <th>
                Level
            </th>
            <th>
                Activé
            </th>
            <th>
                Actions
            </th>
        </tr>
        </thead>
        <tbody>
        {% for category in listCategories %}
            <tr>
                <td>{{ category.id }}</td>
                <td>{{ category.parentCategory }}</td>
                <td>{{ category.name }}</td>
                <td>{{ category.level }}</td>
                <td>{{ category.enable }}</td>
                <td>
                    <a href="{{ path('app_categories_edit', {'id': category.id}) }}">Modifier</a>
                </td>
            </tr>
        {% endfor %}
        </tbody>
    </table>

    <br/>
    <br/>


    <a href="{{ path('app_categories_add') }}">Ajouter une catégorie</a>
    <br/><br/>
    <a href="{{ path('app_home') }}">Retour page d'accueil</a>

{% endblock %}
