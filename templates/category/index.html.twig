{% extends 'base.html.twig' %}

{% block title %} Liste des catégories {% endblock %}

{% block javascripts %}
    {{ parent() }}
    {{ encore_entry_script_tags('category') }}
{% endblock %}

{% block body %}
    <div class="title">Liste des catégories</div>


    <table id="categoryTable" class="display">
        <thead>
        <tr>
            <th>
                ID
            </th>
            <th>
                Catégorie parent
            </th>
            <th>
                Nom
            </th>
            <th>
                Level
            </th>
            <th>
                Activé
            </th>
            <th>
                Actions
            </th>
        </tr>
        </thead>
        <tbody>
        {% for category in listCategories %}
            <tr>
                <td>{{ category.id }}</td>
                <td>{{ category.parentCategory }}</td>
                <td>{{ category.name }}</td>
                <td>{{ category.level }}</td>
                <td>{{ category.enable }}</td>
                <td>
                    <a class="button-primary" href="{{ path('app_categories_edit', {'id': category.id}) }}">
                        <span class="material-symbols-outlined">
                            edit
                        </span>
                    </a>
                </td>
            </tr>
        {% endfor %}
        </tbody>
    </table>


    <div class="flex flex-row mt-5">
        <a href="{{ path('app_categories_add') }}"  class="button-primary">
            Ajouter
        </a>
        <a href="{{ path('app_home') }}" class="button-default"> Retour page d'accueil </a>
    </div>

{% endblock %}
