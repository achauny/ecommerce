{% extends 'base.html.twig' %}

{% block title %} Fiche produit {% endblock %}

{% block body %}
    <div class="title">Fiche du produit</div>

    <dl class="divide-y divide-gray-300">
        <div class="block-tab_informations">
            <dt class="block-tab_informations_title">Nom  :</dt>
            <dd class="block-tab_informations_value">
                {{ product.name }}
            </dd>
        </div>

        <div class="block-tab_informations">
            <dt class="block-tab_informations_title">Catégorie  :</dt>
            <dd class="block-tab_informations_value">
                {{ product.category }}
            </dd>
        </div>

        <div class="block-tab_informations">
            <dt class="block-tab_informations_title">Prix  :</dt>
            <dd class="block-tab_informations_value">
                {{ product.price }}€
            </dd>
        </div>

        <div class="block-tab_informations">
            <dt class="block-tab_informations_title">Quantité  :</dt>
            <dd class="block-tab_informations_value">
                {{ product.stock }}
            </dd>
        </div>

        <div class="block-tab_informations">
            <dt class="block-tab_informations_title">Nombre de vue  :</dt>
            <dd class="block-tab_informations_value">
                {{ product.numberView }}
            </dd>
        </div>

        <div class="block-tab_informations">
            <dt class="block-tab_informations_title">Description :</dt>
            <dd class="block-tab_informations_value">
                {{ product.description }}
            </dd>
        </div>
    </dl>


    <div class="flex flex-row mt-10 ">
        <a href="{{ path('app_cart_product_order', {'id': product.id}) }}" class="button-primary">Commander</a>
        <a href="{{ path('app_products') }}" class="button-default">Retour à la liste des produits </a>
    </div>



{% endblock %}
