{% extends 'base.html.twig' %}

{% block title %} Liste des produits {% endblock %}

{% block stylesheets %}
    <style>
        ul {
            list-style-type: none;
        }
        li {
            margin: 5px 0;
        }
        .submenu {
            margin-left: 20px;
        }
    </style>
{% endblock %}

{% block body %}
    Liste des produits
    <br/>
    <br/>

    {% macro render_menu(items) %}

        {% for id, data in items %}
            <li>
                <a href="{{ path('app_products', {'idCategory': id }) }}"> {{ data.name }} </a>
                {% if data.children is iterable and data.children is not empty %}
                    <ul class="submenu">
                        {{ _self.render_menu(data.children) }}
                    </ul>
                {% endif %}
            </li>
        {% endfor %}
    {% endmacro %}

    <ul>
        <li>
            <a href="{{ path('app_products') }}"> Tous les produits </a>
        </li>
        {{ _self.render_menu(treeCategories) }}
    </ul>


    <table>
        <thead>
        <tr>
            <th>
                ID
            </th>
            <th>
                Catégorie
            </th>
            <th>
                Nom
            </th>
            <th>
                Prix
            </th>
            <th>
                Quantité
            </th>
            <th>
                Nombre de vues
            </th>
            <th>
                Actions
            </th>
        </tr>
        </thead>
        <tbody>
        {% for product in listProducts %}
            <tr>
                <td>{{ product.id }}</td>
                <td>{{ product.category }}</td>
                <td>{{ product.name }}</td>
                <td>{{ product.price }}€</td>
                <td>{{ product.stock }}</td>
                <td>{{ product.numberView }}</td>
                <td>
                    <a href="{{ path('app_products_view', {'id': product.id}) }}">Voir la fiche</a>
                    <a href="{{ path('app_products_order', {'id': product.id, 'idCategory': idCategory | default(null) }) }}">Commander</a>
                    <a href="{{ path('app_products_edit', {'id': product.id}) }}">Modifier</a>
                </td>
            </tr>
        {% endfor %}
        </tbody>
    </table>

    <br/>
    <br/>


    <a href="{{ path('app_products_add') }}">Ajouter un produit</a>
    <br/><br/>
    <a href="{{ path('app_home') }}">Retour page d'accueil</a>

{% endblock %}
