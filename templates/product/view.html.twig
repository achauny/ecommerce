{% extends 'base.html.twig' %}

{% block title %} Fiche produit {% endblock %}

{% block body %}
    Fiche du produit
    <br/>
    <br/>

    Nom : {{ product.name }} <br/>
    Catégorie : {{ product.category }} <br/>
    Prix : {{ product.price }}€ <br/>
    Quantité : {{ product.stock }} <br/>
    Nombre de vues : {{ product.numberView }} <br/>
    Description : {{ product.description }} <br/>


    <br/>
    <a href="{{ path('app_cart_product_order', {'id': product.id}) }}">Commander</a>
    <a href="{{ path('app_products') }}">Retour à la liste des produits </a>

{% endblock %}
