{% extends 'base.html.twig' %}

{% block title %} Votre panier {% endblock %}

{% block javascripts %}
    {{ parent() }}
    {{ encore_entry_script_tags('cart') }}
{% endblock %}

{% block body %}
    <div class="title">Votre panier : {{ total }}€ TTC</div>

    <table id="cartTable" class="display">
        <thead>
        <tr>
            <th>
                Catégorie
            </th>
            <th>
                Nom
            </th>
            <th>
                Prix unitaire TTC
            </th>
            <th>
                Quantité
            </th>
            <th>
                Prix total TTC
            </th>
            <th>
                Actions
            </th>
        </tr>
        </thead>
        <tbody>
            {% for cartProduct in cart.cartProducts %}
                <tr>
                    <td>{{ cartProduct.product.category }}</td>
                    <td>{{ cartProduct.product.name }}</td>
                    <td>{{ cartProduct.product.price }}€</td>
                    <td>{{ cartProduct.quantity }}</td>
                    <td>{{ cartProduct.product.price *  cartProduct.quantity }}€</td>
                    <td>
                        <a class="button-default" href="{{ path('app_products_view', {'id': cartProduct.product.id}) }}">
                            <span class="material-symbols-outlined">
                                visibility
                            </span>
                        </a>
                        <a class="button-danger" href="{{ path('app_cart_product_delete', {'id': cartProduct.id }) }}">
                            <span class="material-symbols-outlined">
                                delete
                            </span>
                        </a>
                    </td>
                </tr>
            {% endfor %}
        </tbody>
    </table>

    <div class="flex flex-row mt-5">

        <a href="{{ path('app_products') }}" class="button-default"> Retour à la liste des produits </a>
    </div>
{% endblock %}
