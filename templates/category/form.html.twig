{% extends 'base.html.twig' %}

{% block title %}
    {% if product is not defined %}
        Ajouter un produit
    {% else %}
        Modifier un produit
    {% endif %}
{% endblock %}

{% block body %}
    {{ form_start(form) }}
    <div class="form-group">
        {{ form_label(form.name) }}
        {{ form_widget(form.name) }}
    </div>

    <div class="form-group">
        {{ form_label(form.parentCategory) }}
        {{ form_widget(form.parentCategory) }}
    </div>

    <div class="form-group">
        {{ form_label(form.level) }}
        {{ form_widget(form.level) }}
    </div>

    <div class="form-group">
        {{ form_label(form.priority) }}
        {{ form_widget(form.priority) }}
    </div>

    <button type="submit" class="btn btn-primary">
        {% if product is not defined %}
            Ajouter
        {% else %}
            Modifier
        {% endif %}
    </button>
    {{ form_end(form) }}

    <a href="{{ path('app_categories') }}"> Retour </a>

{% endblock %}
