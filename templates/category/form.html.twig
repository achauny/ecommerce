{% extends 'base.html.twig' %}

{% block title %}
    {% if category is not defined %}
        Ajouter une catégorie
    {% else %}
        Modifier une catégorie
    {% endif %}
{% endblock %}

{% block body %}
    <div class="title">
        {% if category is not defined %}
            Ajouter une catégorie
        {% else %}
            Modifier une catégorie
        {% endif %}
    </div>

    {{ form_start(form) }}
    <div class="form-group">
        {{ form_label(form.name) }}
        {{ form_widget(form.name) }}
    </div>

    <div class="form-group">
        {{ form_label(form.parentCategory) }}
        {{ form_widget(form.parentCategory) }}
    </div>

    <div class="form-group">
        {{ form_label(form.level) }}
        {{ form_widget(form.level) }}
    </div>

    <div class="form-group">
        {{ form_label(form.priority) }}
        {{ form_widget(form.priority) }}
    </div>


    <div class="flex flex-row mt-10 ">
        <button type="submit" class="button-primary">
            {% if category is not defined %}
                Ajouter
            {% else %}
                Modifier
            {% endif %}
        </button>
        <a href="{{ path('app_categories') }}" class="button-default"> Retour à la liste des catégories </a>
    </div>

    {{ form_end(form) }}


{% endblock %}
